{
  "name": "neon-drift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:cross-engine": "playwright test --config playwright.cross-engine.config.ts",
    "e2e:validation": "playwright test --config playwright.validation.config.ts",
    "ux:capture": "UX_CAPTURE=1 playwright test e2e/ux-capture.spec.ts --workers=1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "three": "^0.185.1"
  }
}
