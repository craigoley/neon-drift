{
  "name": "neon-drift",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:cross-engine": "playwright test --config playwright.cross-engine.config.ts",
    "e2e:validation": "playwright test --config playwright.validation.config.ts",
    "ux:capture": "UX_CAPTURE=1 playwright test e2e/ux-capture.spec.ts --workers=1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.0.1",
    "@types/three": "^0.185.0",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.1",
    "vite": "^8.1.2",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "three": "^0.185.0"
  }
}
